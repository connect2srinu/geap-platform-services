# Review ownership.
#
# IMPORTANT: this file ASSIGNS reviewers. It does not REQUIRE review. Requiring review is a
# branch protection / ruleset setting that a repository administrator must configure by hand.
# See docs/operations/repository-administration.md. A CODEOWNERS file in a repository with no
# branch protection enforces nothing.
#
# THIS REPOSITORY has one maintainer, so every path names @connect2srinu, and review is not
# required here (docs/operations/repository-administration.md §0). The intended team for each
# path is kept in the '# team:' comment above it. An organization adopting this layout replaces
# @connect2srinu with those teams and turns on "Require review from Code Owners".

# Default
# team: agent-platform
*                                   @connect2srinu

# The strictest ownership in the repository: the tool API is identical across every domain,
# so a change here affects every agent team integrating with any domain.
# team: platform-architects
/patterns/*/contracts/              @connect2srinu
# team: platform-architects
/standards/api-design.md            @connect2srinu
# team: platform-architects
/schemas/                           @connect2srinu

# Security
# team: security-reviewers
/standards/security.md              @connect2srinu
# team: security-reviewers
**/controls-check.md                @connect2srinu
# team: security-reviewers
/.claude/rules/security-baseline.md @connect2srinu

# Platform-owned infrastructure is the only hard-enforcement seam.
# team: platform-architects security-reviewers
/patterns/*/infrastructure/terraform/memory-bank-nfr/   @connect2srinu
# team: platform-architects security-reviewers
/patterns/*/infrastructure/terraform/platform-owned/    @connect2srinu

# The SDLC itself
# team: platform-leads
/CLAUDE.md                          @connect2srinu
# team: platform-leads
/.claude/                           @connect2srinu
# team: platform-leads
/standards/                         @connect2srinu
# team: platform-leads
/.github/workflows/                 @connect2srinu

# Release machinery
# team: platform-leads
/standards/release-management.md    @connect2srinu
