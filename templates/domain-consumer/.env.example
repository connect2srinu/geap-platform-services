# Names and empty values ONLY. Never commit a populated .env.
#
# Secrets are resolved from Secret Manager at runtime and injected by the deployment; they are
# named here so a developer knows what the service needs, not stored here.
#
#   cp .env.example .env    then fill .env in locally. .env is git-ignored.

# Where the service reads its domain configuration. Matches the container default, so a
# deployment that mounts config/ at /app/config needs no override.
CONFIG_PATH=

# `local` enables the in-process fake memory bank and the header-based subject shortcut. The
# service REFUSES to start with either outside a local environment — not defaulted off, refused.
ENVIRONMENT=

# The Cloud Run instance ceiling. The per-instance write budget is your domain's agreed share
# divided by this, so it must match the deployed max-instances or the budget is wrong.
MAX_INSTANCES=

# Secret Manager: the HMAC key that pseudonymises an end-user subject before it reaches a scope,
# a log, a metric or an extension. Rotating it makes existing memories unreachable — it is part
# of the scope, not a transport detail.
SUBJECT_HMAC_KEY=

# Required when ENVIRONMENT is not local.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
MEMORY_BANK_ID=
