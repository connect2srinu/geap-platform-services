{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geap.example/schemas/design-artifacts.schema.json",
  "title": "GEAP design artifact front matter",
  "description": "YAML front matter required on every SDLC design artifact. See .claude/rules/sdlc-gates.md.",
  "type": "object",
  "required": [
    "artifact",
    "feature",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "artifact": {
      "enum": [
        "intent",
        "design"
      ],
      "description": "Two artifacts only. See CLAUDE.md."
    },
    "feature": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z][a-z0-9-]*$",
      "description": "Matches the design folder and the branch name."
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "approved",
        "superseded"
      ],
      "description": "Only a human sets 'approved'. Claude must never self-approve."
    },
    "approved_by": {
      "type": "string",
      "description": "Required when status is approved. Must not be an AI agent."
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601, YYYY-MM-DD."
    },
    "supersedes": {
      "type": "string"
    },
    "related_adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      }
    },
    "patterns_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approved_by",
          "approved_date"
        ]
      }
    }
  ]
}
